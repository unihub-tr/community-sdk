{
  "name": "unihub-community-sdk",
  "version": "0.1.3",
  "description": "Official browser SDK for UniHub community websites: public events, sign-in with UniHub, and attendance (join, status, leave, ticket, application forms).",
  "keywords": [
    "unihub",
    "community",
    "university",
    "club",
    "events",
    "sdk",
    "browser",
    "typescript"
  ],
  "homepage": "https://github.com/unihub-tr/community-sdk#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/unihub-tr/community-sdk.git"
  },
  "bugs": {
    "url": "https://github.com/unihub-tr/community-sdk/issues"
  },
  "license": "MIT",
  "author": "UniHub Team",
  "type": "commonjs",
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "unpkg": "dist/index.global.js",
  "jsdelivr": "dist/index.global.js",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "starter",
    "CHANGELOG.md"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "test:contract": "vitest run -c vitest.contract.config.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc -p tsconfig.test.json",
    "clean": "node -e \"for (const p of ['dist','coverage']) require('fs').rmSync(p,{recursive:true,force:true})\"",
    "prepublishOnly": "npm run typecheck && npm test && npm run build && node scripts/check-release.mjs"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "tsup": "^8.0.2",
    "typescript": "^5.3.3",
    "vitest": "^5.0.3"
  }
}
